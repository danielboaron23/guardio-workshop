// Copies the repo's single sources into this static folder, so the mobile concept
// pages (GitHub Pages, no build step) use the real tokens, data and icons.
//   tokens.css ← packages/tokens/dist/tokens.css (Tailwind @theme → :root)
//   data.js    ← packages/data/src/todos.ts
//   assets/    ← packages/assets (only the files the pages use)
// Run from the repo root after changing tokens, to-do data or icons:
//   node docs/todos-mobile/export.mts
import { execFileSync } from 'node:child_process'
import { copyFileSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'

import { TODO_KINDS, rankedTodos, todoBundles, todosPage } from '../../packages/data/src/todos.ts'

const here = (p: string) => new URL(p, import.meta.url)
const header = '/* Generated by docs/todos-mobile/export.mts — do not edit by hand. */\n'

const css = readFileSync(here('../../packages/tokens/dist/tokens.css'), 'utf8')
  .replace(/^\/\*.*\*\/\n/, '')
  .replace('@theme {', ':root {')
writeFileSync(here('./tokens.css'), header + css)

writeFileSync(
  here('./data.js'),
  `${header}window.TODOS = ${JSON.stringify({ TODO_KINDS, rankedTodos, todoBundles, todosPage }, null, 2)};\n`,
)

const ASSETS: [string, string][] = [
  // brand logos and device icons, by IconKey
  ...['apple.svg', 'dropbox.jpg', 'facebook.svg', 'gmail.png', 'google.svg', 'instagram.png', 'mcdonalds.jpg', 'spotify.png', 'tiktok.jpg', 'tripadvisor.jpg', 'wolt.jpg'].map(
    (f): [string, string] => [`home/logo-${f}`, f],
  ),
  ['home/d-smartphone.svg', 'smartphone.svg'],
  ['home/d-scan-face.svg', 'scanFace.svg'],
  ['home/d-mail.svg', 'mail.svg'],
  ['home/d-laptop.svg', 'laptop.svg'],
  // the iOS shell
  ['home/statusbar-signal.svg', 'statusbar-signal.svg'],
  ['home/statusbar-wifi.svg', 'statusbar-wifi.svg'],
  ['home/statusbar-battery.svg', 'statusbar-battery.svg'],
  ['home/tab-home.svg', 'tab-home.svg'],
  ['home/tab-assets.svg', 'tab-assets.svg'],
  ['home/tab-todos.svg', 'tab-todos.svg'],
  ['home/tab-activity.svg', 'tab-activity.svg'],
  ['home/tab-account.svg', 'tab-account.svg'],
  // UI icons
  ['home/badge-clock.svg', 'clock.svg'],
  ['settings/check-circle.svg', 'check-circle.svg'],
  ['home/d-chevron-down.svg', 'chevron-down.svg'],
  ['home/activated-todo-chevron-right.svg', 'chevron-right.svg'],
  ['home/d-ticker-shield.svg', 'shield.svg'],
]
mkdirSync(here('./assets'), { recursive: true })
for (const [from, to] of ASSETS) copyFileSync(here(`../../packages/assets/${from}`), here(`./assets/${to}`))

// Logos are shown at 24px; some sources are large (instagram.png is ~2 MB). On macOS,
// shrink the copies to 96px with the built-in `sips` (the sources stay untouched).
if (process.platform === 'darwin') {
  for (const [, to] of ASSETS.filter(([, t]) => /\.(png|jpg)$/.test(t))) {
    execFileSync('sips', ['-Z', '96', new URL(`./assets/${to}`, import.meta.url).pathname], { stdio: 'ignore' })
  }
}

console.log(`tokens.css, data.js and ${ASSETS.length} assets written to docs/todos-mobile/`)
